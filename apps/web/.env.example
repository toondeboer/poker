# Monetization config for @poker/web. Copy to `.env.local` for local dev and set
# the same values in the Vercel project for production. All are optional — when a
# value is unset the related UI (tip jar / ad slot) renders nothing.

# Tip jar: your Ko-fi profile URL. Powers the floating Ko-fi "Support Me" widget
# (the username is derived from the URL). e.g. https://ko-fi.com/yourname
NEXT_PUBLIC_TIP_JAR_URL=

# Google AdSense publisher id, e.g. ca-pub-1234567890123456
NEXT_PUBLIC_ADSENSE_CLIENT=

# AdSense ad unit slot ids (create one display unit per placement in AdSense).
NEXT_PUBLIC_ADSENSE_SLOT_LANDING=
NEXT_PUBLIC_ADSENSE_SLOT_TIMER=
