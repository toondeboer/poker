{
  "name": "@poker/mobile",
  "main": "expo-router/entry",
  "version": "1.0.0",
  "scripts": {
    "start": "expo start",
    "reset-project": "node ./scripts/reset-project.js",
    "preandroid": "node ./scripts/clean-expo-shims.js --gradle-cache",
    "android": "expo run:android",
    "preandroid:device": "node ./scripts/clean-expo-shims.js --gradle-cache",
    "android:device": "expo run:android --device",
    "preios": "node ./scripts/clean-expo-shims.js",
    "ios": "expo run:ios",
    "preios:device": "node ./scripts/clean-expo-shims.js",
    "ios:device": "expo run:ios --device",
    "preprebuild": "node ./scripts/clean-expo-shims.js --gradle-cache",
    "prebuild": "expo prebuild",
    "prepods": "node ./scripts/clean-expo-shims.js",
    "pods": "cd ios && pod install",
    "eas:build": "eas build --profile production",
    "eas:build:ios": "eas build --platform ios --profile production",
    "eas:build:android": "eas build --platform android --profile production",
    "eas:submit": "eas submit --latest --profile internal",
    "eas:submit:ios": "eas submit -p ios --latest --profile internal",
    "eas:submit:android": "eas submit -p android --latest --profile internal",
    "prelint": "node ./scripts/clean-expo-shims.js",
    "lint": "expo lint",
    "pretypecheck": "node ./scripts/clean-expo-shims.js",
    "typecheck": "tsc --noEmit",
    "eas:submit:production": "eas submit --latest --profile production",
    "eas:submit:ios:production": "eas submit -p ios --latest --profile production",
    "eas:submit:android:production": "eas submit -p android --latest --profile production"
  },
  "dependencies": {
    "@expo/vector-icons": "^15.0.2",
    "@poker/core": "*",
    "@react-native-async-storage/async-storage": "^3.1.1",
    "expo": "~57.0.14",
    "expo-audio": "~57.0.3",
    "expo-build-properties": "~57.0.12",
    "expo-constants": "~57.0.12",
    "expo-dev-client": "~57.0.13",
    "expo-font": "~57.0.1",
    "expo-keep-awake": "~57.0.1",
    "expo-linear-gradient": "~57.0.1",
    "expo-linking": "~57.0.6",
    "expo-notifications": "~57.0.12",
    "expo-router": "~57.0.14",
    "expo-splash-screen": "~57.0.7",
    "expo-status-bar": "~57.0.1",
    "expo-store-review": "~57.0.2",
    "react": "19.2.3",
    "react-native": "0.87.0",
    "react-native-edge-to-edge": "^1.8.1",
    "react-native-gesture-handler": "~3.2.1",
    "react-native-google-mobile-ads": "^16.5.0",
    "react-native-purchases": "^10.7.1",
    "react-native-reanimated": "4.5.3",
    "react-native-safe-area-context": "~5.9.1",
    "react-native-screens": "4.27.0",
    "react-native-worklets": "0.12.1"
  },
  "devDependencies": {
    "@babel/core": "^8.0.1",
    "@types/react": "~19.2.0",
    "eslint": "^9.25.0",
    "eslint-config-expo": "~56.0.4",
    "typescript": "~5.8.3"
  },
  "expo": {
    "install": {
      "exclude": [
        "@react-native-async-storage/async-storage",
        "typescript"
      ]
    }
  },
  "private": true
}
