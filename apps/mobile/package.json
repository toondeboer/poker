{
  "name": "@poker/mobile",
  "main": "expo-router/entry",
  "version": "1.0.0",
  "scripts": {
    "start": "NODE_PATH=node_modules expo start",
    "reset-project": "node ./scripts/reset-project.js",
    "preandroid": "node ./scripts/clean-expo-shims.js --gradle-cache",
    "android": "NODE_PATH=node_modules expo run:android",
    "preandroid:device": "node ./scripts/clean-expo-shims.js --gradle-cache",
    "android:device": "NODE_PATH=node_modules expo run:android --device",
    "preios": "node ./scripts/clean-expo-shims.js",
    "ios": "NODE_PATH=node_modules expo run:ios",
    "preios:device": "node ./scripts/clean-expo-shims.js",
    "ios:device": "NODE_PATH=node_modules expo run:ios --device",
    "preprebuild": "node ./scripts/clean-expo-shims.js --gradle-cache",
    "prebuild": "expo prebuild",
    "prepods": "node ./scripts/clean-expo-shims.js",
    "pods": "cd ios && pod install",
    "eas:build": "eas build --profile production",
    "eas:build:ios": "eas build --platform ios --profile production",
    "eas:build:android": "eas build --platform android --profile production",
    "eas:submit": "eas submit --latest --profile internal",
    "eas:submit:ios": "eas submit -p ios --latest --profile internal",
    "eas:submit:android": "eas submit -p android --latest --profile internal",
    "prelint": "node ./scripts/clean-expo-shims.js",
    "lint": "expo lint",
    "pretypecheck": "node ./scripts/clean-expo-shims.js",
    "typecheck": "tsc --noEmit",
    "eas:submit:production": "eas submit --latest --profile production",
    "eas:submit:ios:production": "eas submit -p ios --latest --profile production",
    "eas:submit:android:production": "eas submit -p android --latest --profile production"
  },
  "dependencies": {
    "@expo/vector-icons": "^15.0.2",
    "@poker/core": "*",
    "@react-native-async-storage/async-storage": "^3.1.1",
    "expo": "~56.0.20",
    "expo-audio": "~56.0.13",
    "expo-build-properties": "~56.0.26",
    "expo-constants": "~56.0.18",
    "expo-dev-client": "~56.0.25",
    "expo-font": "~56.0.6",
    "expo-keep-awake": "~56.0.3",
    "expo-linear-gradient": "~56.0.4",
    "expo-linking": "~56.0.17",
    "expo-notifications": "~56.0.24",
    "expo-router": "~56.2.19",
    "expo-splash-screen": "~56.0.14",
    "expo-status-bar": "~56.0.4",
    "expo-store-review": "~56.0.4",
    "react": "19.2.3",
    "react-native": "0.85.3",
    "react-native-edge-to-edge": "^1.8.1",
    "react-native-gesture-handler": "~2.31.1",
    "react-native-google-mobile-ads": "^16.3.4",
    "react-native-purchases": "^10.4.4",
    "react-native-reanimated": "4.3.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-worklets": "0.8.3"
  },
  "devDependencies": {
    "@babel/core": "^7.29.7",
    "@types/react": "~19.2.0",
    "eslint": "^9.25.0",
    "eslint-config-expo": "~56.0.4",
    "typescript": "~5.8.3"
  },
  "expo": {
    "install": {
      "exclude": [
        "@react-native-async-storage/async-storage",
        "typescript"
      ]
    }
  },
  "private": true
}
