<?xml version="1.0" encoding="utf-8"?>
<!-- Collapsed body for the timer notification's DecoratedCustomViewStyle. The system still
     draws the header (small icon in its colored circle, app label, timestamp, expand chevron)
     above this — this only supplies the content row. A custom view rather than the stock layout
     because the title carries the round's state color, which stock can't render. -->
<!-- paddingTop/Bottom stay small on purpose: DecoratedCustomViewStyle imposes its own overall
     height budget on the combined card, tighter on some OEM skins than stock AOSP, and an
     over-tall row here gets its bottom edge silently clipped rather than reported as a layout
     error. That was the cause of the "buttons cut off in the collapsed notification" bug back
     when this row still had buttons. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:paddingStart="12dp"
    android:paddingEnd="12dp"
    android:paddingTop="6dp"
    android:paddingBottom="6dp">

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/timer_collapsed_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:singleLine="true"
            android:ellipsize="end"
            android:textSize="14sp"
            android:textStyle="bold"
            android:textColor="?android:attr/textColorPrimary"/>

        <TextView
            android:id="@+id/timer_collapsed_subtitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:singleLine="true"
            android:ellipsize="end"
            android:textSize="12sp"
            android:textColor="?android:attr/textColorSecondary"/>
    </LinearLayout>

</LinearLayout>
