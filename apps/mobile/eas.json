{
  "cli": {
    "version": ">= 16.17.0",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "env": {
        "EXPO_USE_PRECOMPILED_MODULES": "0",
        "RCT_USE_PREBUILT_RNCORE": "0"
      }
    },
    "preview": {
      "distribution": "internal",
      "env": {
        "EXPO_USE_PRECOMPILED_MODULES": "0",
        "RCT_USE_PREBUILT_RNCORE": "0"
      }
    },
    "production": {
      "autoIncrement": true,
      "env": {
        "EXPO_USE_PRECOMPILED_MODULES": "0",
        "RCT_USE_PREBUILT_RNCORE": "0"
      }
    }
  },
  "submit": {
    "internal": {
      "ios": {
        "ascAppId": "6749512168"
      },
      "android": {
        "track": "internal"
      }
    },
    "production": {
      "ios": {
        "ascAppId": "6749512168"
      },
      "android": {
        "track": "production"
      }
    }
  }
}
