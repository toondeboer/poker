{
  "name": "poker-monorepo",
  "version": "0.0.0",
  "private": true,
  "packageManager": "npm@11.12.1",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "build": "turbo run build",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "web": "npm run dev --workspace @poker/web",
    "mobile": "npm run start --workspace @poker/mobile",
    "ios": "npm run ios --workspace @poker/mobile",
    "ios:device": "npm run ios:device --workspace @poker/mobile",
    "android": "npm run android --workspace @poker/mobile",
    "android:device": "npm run android:device --workspace @poker/mobile",
    "pods": "npm run pods --workspace @poker/mobile",
    "eas:build": "npm run eas:build --workspace @poker/mobile",
    "eas:build:ios": "npm run eas:build:ios --workspace @poker/mobile",
    "eas:build:android": "npm run eas:build:android --workspace @poker/mobile",
    "eas:submit": "npm run eas:submit --workspace @poker/mobile",
    "eas:submit:ios": "npm run eas:submit:ios --workspace @poker/mobile",
    "eas:submit:android": "npm run eas:submit:android --workspace @poker/mobile",
    "postinstall": "node apps/mobile/scripts/clean-expo-shims.js",
    "eas:submit:production": "npm run eas:submit:production --workspace @poker/mobile",
    "eas:submit:ios:production": "npm run eas:submit:ios:production --workspace @poker/mobile",
    "eas:submit:android:production": "npm run eas:submit:android:production --workspace @poker/mobile"
  },
  "devDependencies": {
    "turbo": "^2",
    "typescript": "~7.0.2"
  },
  "engines": {
    "node": ">=20"
  }
}
