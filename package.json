{
  "name": "poker-monorepo",
  "version": "0.0.0",
  "private": true,
  "packageManager": "npm@11.12.1",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "build": "turbo run build",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "web": "npm run dev --workspace @poker/web",
    "mobile": "npm run start --workspace @poker/mobile",
    "ios": "npm run ios --workspace @poker/mobile",
    "ios:device": "npm run ios:device --workspace @poker/mobile",
    "android": "npm run android --workspace @poker/mobile",
    "android:device": "npm run android:device --workspace @poker/mobile",
    "pods": "npm run pods --workspace @poker/mobile",
    "eas:build:ios": "npm run eas:build:ios --workspace @poker/mobile",
    "eas:build:android": "npm run eas:build:android --workspace @poker/mobile",
    "eas:submit:ios": "npm run eas:submit:ios --workspace @poker/mobile",
    "eas:submit:android": "npm run eas:submit:android --workspace @poker/mobile"
  },
  "devDependencies": {
    "next": "16.3.0",
    "turbo": "^2",
    "typescript": "~5.8.3"
  },
  "overrides": {
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "@types/react": "~19.2.0",
    "@types/react-dom": "~19.2",
    "postcss": "^8.5.10"
  },
  "engines": {
    "node": ">=20"
  }
}
