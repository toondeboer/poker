# Dependencies
node_modules/
.pnp
.pnp.*

# Only the root lockfile is used (npm workspaces); keep nested ones out
apps/*/package-lock.json

# Turborepo
.turbo

# Coverage reports. `@poker/core`'s vitest config writes an HTML reporter, so
# running the tests leaves ~48k lines of generated markup in the working tree —
# which is easy to sweep into a commit with `git add -A`, and has been twice.
# CodeQL then scans it and reports XSS in Istanbul's bundled `sorter.js`.
coverage/

