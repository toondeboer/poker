# Dependencies
node_modules/
.pnp
.pnp.*

# Only the root lockfile is used (npm workspaces); keep nested ones out
apps/*/package-lock.json

# Turborepo
.turbo

# Coverage reports. `@poker/core`'s vitest config writes an HTML reporter, so
# running the tests leaves ~22k lines of generated markup in the working tree —
# which is easy to sweep into a commit with `git add -A`, and was.
coverage/

# Build outputs
dist/
.next/
out/
web-build/
*.tsbuildinfo

# Expo / React Native
.expo/
expo-env.d.ts
.metro-health-check*
.kotlin/
apps/mobile/ios/build/
apps/mobile/ios/Pods/
apps/mobile/android/build/
apps/mobile/android/app/build/
apps/mobile/android/.gradle/

# Next.js
next-env.d.ts
.vercel
apps/web/public/sw.js
apps/web/public/workbox-*.js

# Native signing / secrets
*.jks
*.p8
*.p12
*.key
*.mobileprovision
*.orig.*

# Firebase **service account** keys — real credentials that can send push as
# this app, and Firebase downloads them with this name into whatever directory
# you were last in. EAS holds the only copy that needs to exist.
#
# Not to be confused with `google-services.json`, which is committed on purpose:
# it ships inside the APK, is extractable from it, and the build needs it.
*-firebase-adminsdk-*.json
**/serviceAccountKey.json

# Env files
.env*
!.env.example

# Editor / OS
.DS_Store
.idea/
*.pem
.vscode/

# Logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
coverage/
